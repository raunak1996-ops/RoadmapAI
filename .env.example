# Google Gen AI (Gemini) API key — https://aistudio.google.com/apikey
#
# NOTE: Vite inlines any VITE_-prefixed variable into the client bundle, so this
# key is visible to anyone who loads the page. Use a key that is restricted /
# rate-limited, or proxy the calls through your own backend before shipping to
# real users. RoadmapAI runs fully in Demo Mode (deterministic local synthesis)
# when no key is present, which is how the public GitHub Pages build is meant
# to be deployed.
VITE_GEMINI_API_KEY=

# Optional: model override. Defaults to gemini-2.5-flash.
VITE_GEMINI_MODEL=gemini-2.5-flash
